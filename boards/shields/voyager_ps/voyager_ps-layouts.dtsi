#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        keys  //                     w   h    x    y     rot    rx    ry
            // Left hand - Row 0 (num)
            = <&key_physical_attrs 100 100    0   41       0     0     0>    // outer
            , <&key_physical_attrs 100 100  100   41       0     0     0>    // pinkey
            , <&key_physical_attrs 100 100  200   18       0     0     0>    // ring
            , <&key_physical_attrs 100 100  300    0       0     0     0>    // middle
            , <&key_physical_attrs 100 100  400   34       0     0     0>    // index
            , <&key_physical_attrs 100 100  500   51       0     0     0>    // inner
            // Right hand - Row 0 (num)
            , <&key_physical_attrs 100 100  800   51       0     0     0>    // inner
            , <&key_physical_attrs 100 100  900   34       0     0     0>    // index
            , <&key_physical_attrs 100 100 1000    0       0     0     0>    // middle
            , <&key_physical_attrs 100 100 1100   18       0     0     0>    // ring
            , <&key_physical_attrs 100 100 1200   41       0     0     0>    // pinkey
            , <&key_physical_attrs 100 100 1300   41       0     0     0>    // outer

            // Left hand - Row 1 (top)
            , <&key_physical_attrs 100 100    0  141       0     0     0>
            , <&key_physical_attrs 100 100  100  141       0     0     0>
            , <&key_physical_attrs 100 100  200  118       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  134       0     0     0>
            , <&key_physical_attrs 100 100  500  151       0     0     0>
            // Right hand - Row 1 (top)
            , <&key_physical_attrs 100 100  800  151       0     0     0>
            , <&key_physical_attrs 100 100  900  134       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  118       0     0     0>
            , <&key_physical_attrs 100 100 1200  141       0     0     0>
            , <&key_physical_attrs 100 100 1300  141       0     0     0>

            // Left hand - Row 2 (home)
            , <&key_physical_attrs 100 100    0  241       0     0     0>
            , <&key_physical_attrs 100 100  100  241       0     0     0>
            , <&key_physical_attrs 100 100  200  218       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  234       0     0     0>
            , <&key_physical_attrs 100 100  500  251       0     0     0>
            // Right hand - Row 2 (home)
            , <&key_physical_attrs 100 100  800  251       0     0     0>
            , <&key_physical_attrs 100 100  900  234       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  218       0     0     0>
            , <&key_physical_attrs 100 100 1200  241       0     0     0>
            , <&key_physical_attrs 100 100 1300  241       0     0     0>

            // Left hand - Row 3 (bottom)
            , <&key_physical_attrs 100 100    0  341       0     0     0>
            , <&key_physical_attrs 100 100  100  341       0     0     0>
            , <&key_physical_attrs 100 100  200  318       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  334       0     0     0>
            , <&key_physical_attrs 100 100  500  351       0     0     0>
            // Right hand - Row 3 (bottom)
            , <&key_physical_attrs 100 100  800  351       0     0     0>
            , <&key_physical_attrs 100 100  900  334       0     0     0>
            , <&key_physical_attrs 100 100 1000  300       0     0     0>
            , <&key_physical_attrs 100 100 1100  318       0     0     0>
            , <&key_physical_attrs 100 100 1200  341       0     0     0>
            , <&key_physical_attrs 100 100 1300  341       0     0     0>

            // Left encoder push-button (above outer column, shares P21 row + P9 col)
            , <&key_physical_attrs 100 100  600  (-59)     0     0     0>    // encoder button (left)

            // Left hand - Row 4 (thumb cluster)
            , <&key_physical_attrs 100 100  400  451       0     0     0>    // thumb_left (P14)
            , <&key_physical_attrs 100 100  500  468    3000   550   518>    // thumb_middle (P15, rotated 30deg)
            , <&key_physical_attrs 100 100  580  420    3000   550   518>    // thumb_right (P18, rotated 30deg)
            , <&key_physical_attrs 100 100  580  320    3000   550   518>    // thumb_top (P20, rotated 30deg)
            // Right hand - Row 4 (thumb cluster)
            , <&key_physical_attrs 100 100  720  320  33000   750   518>    // thumb_top (P20, rotated -30deg)
            , <&key_physical_attrs 100 100  720  420  33000   750   518>    // thumb_right (P18, rotated -30deg)
            , <&key_physical_attrs 100 100  800  468  33000   750   518>    // thumb_middle (P15, rotated -30deg)
            , <&key_physical_attrs 100 100  900  451       0     0     0>    // thumb_left (P14)

            // Right encoder push-button (mirror of left)
            , <&key_physical_attrs 100 100  700  (-59)     0     0     0>    // encoder button (right)
            ;
    };
};
